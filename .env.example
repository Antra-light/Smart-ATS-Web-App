# Copy this file to `.env` and fill in your own values. NEVER commit `.env`.

# Required: your Google Gemini API key (https://aistudio.google.com/app/apikey)
GOOGLE_API_KEY="your-gemini-api-key-here"

# Optional: pin a specific Gemini model (defaults try gemini-2.5-flash, then fallbacks)
# GEMINI_MODEL="gemini-2.5-flash"

# Optional: Flask session signing secret. If unset, a random one is generated
# and stored in .flask_secret (gitignored). Set a long random value in production.
# FLASK_SECRET="change-me-to-a-long-random-string"

# Optional: enable Flask debug locally (do NOT enable in production)
# FLASK_DEBUG="1"

# Optional: set when serving over HTTPS so the session cookie is marked Secure
# HTTPS="1"

# Optional: the browser origin allowed to make credentialed requests
# FRONTEND_ORIGIN="http://localhost:5000"
