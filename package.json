{
    "name": "smart-ats",
    "version": "1.0.0",
    "private": true,
    "scripts": {
        "dev": "concurrently \"next dev\" \"ts-node-dev --respawn --transpile-only server/index.ts\"",
        "dev:client": "next dev",
        "dev:server": "ts-node-dev --respawn --transpile-only server/index.ts",
        "build": "next build",
        "start": "next start",
        "prisma:generate": "prisma generate",
        "prisma:migrate": "prisma migrate dev --name init"
    },
    "dependencies": {
        "@prisma/client": "^5.19.0",
        "axios": "^1.7.0",
        "bcryptjs": "^2.4.3",
        "cookie-parser": "^1.4.6",
        "cors": "^2.8.5",
        "dotenv": "^16.4.3",
        "express": "^4.18.2",
        "framer-motion": "^11.2.6",
        "jsonwebtoken": "^9.0.2",
        "next": "14.2.5",
        "pdf-parse": "^1.1.1",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "tesseract.js": "^7.0.0",
        "tailwindcss": "^3.4.4"
    },
    "devDependencies": {
        "prisma": "^5.19.0",
        "@types/bcryptjs": "^2.4.2",
        "@types/cookie-parser": "^1.4.3",
        "@types/cors": "^2.8.17",
        "@types/express": "^4.17.18",
        "@types/jsonwebtoken": "^9.0.2",
        "@types/node": "^20.11.0",
        "@types/react": "^18.3.3",
        "@types/react-dom": "^18.3.0",
        "autoprefixer": "^10.4.19",
        "concurrently": "^9.2.1",
        "postcss": "^8.4.35",
        "ts-node-dev": "^2.0.0",
        "typescript": "^5.6.2",
        "@types/multer": "^1.4.8",
        "@types/pdf-parse": "^1.1.5"
    }
}